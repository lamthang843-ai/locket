#!name=Locket Gold Bypass
#!desc=Kích hoạt Gold và Photo Booth

[Script]
locket_gold = type=http-response, pattern=^https:\/\/api\.revenuecat\.com\/.+|^https:\/\/api\.locket\.com\/.+$, script-path=https://raw.githubusercontent.com/lamthang843-ai/locket/refs/heads/main/locket_gold.js, requires-body=true, max-size=-1, timeout=60

[MITM]
hostname = %APPEND% api.locket.com, api.revenuecat.com
